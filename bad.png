<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 — Página não encontrada | AdminEscala</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%23ec3333'/><text y='22' x='6' font-size='18' font-family='sans-serif' font-weight='bold' fill='white'>A</text></svg>">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ============================================ */
        /* ROOT VARIABLES — AdminEscala Design System   */
        /* ============================================ */
:root {
    --primary:        #ec3333;
    --primary-dark:   #c82333;
    --primary-glow:   rgba(236, 51, 51, 0.18);
    --sidebar-bg:     #0a0c12;
    --surface-2:      #9d9d9d;
    --surface-3:      #090b10;
    --text:           #f0f2f5;
    --text-muted:     #ffffff;
    --success:        #10b981;
    --card-shadow:    0 2px 20px rgba(0, 0, 0, 0.4);
    --card-shadow-xl: 0 20px 60px rgba(0, 0, 0, 0.5);
    --radius:         14px;
    --radius-sm:      8px;
    --transition:     all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

        /* ============================================ */
        /* RESET & BASE                                 */
        /* ============================================ */
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            font-family: 'Sora', sans-serif;
            background: var(--surface-2);
            color: var(--text);
            overflow: hidden;
            font-size: 16px;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            position: relative;
        }

        /* ============================================ */
        /* BACKGROUND DECORATIONS                       */
        /* ============================================ */
        .bg-grid {
            position: fixed;
            inset: 0;
            background-image:
                linear-gradient(var(--border) 1px, transparent 1px),
                linear-gradient(90deg, var(--border) 1px, transparent 1px);
            background-size: 40px 40px;
            opacity: 0.5;
            pointer-events: none;
            z-index: 0;
        }

        .bg-glow {
            position: fixed;
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
            filter: blur(80px);
            opacity: 0;
            animation: glowReveal 1.2s ease 0.3s forwards;
        }

        .bg-glow-1 {
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(236, 51, 51, 0.10) 0%, transparent 70%);
            top: -200px;
            right: -100px;
        }

        .bg-glow-2 {
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.07) 0%, transparent 70%);
            bottom: -150px;
            left: -100px;
        }

        @keyframes glowReveal {
            to { opacity: 1; }
        }

        /* ============================================ */
        /* WRAPPER                                      */
        /* ============================================ */
        .wrapper {
            position: relative;
            z-index: 1;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 32px 20px;
        }

        /* ============================================ */
        /* LOGO TOP LEFT                                */
        /* ============================================ */
        .logo-link {
            position: fixed;
            top: 24px;
            left: 28px;
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            z-index: 10;
            opacity: 0;
            transform: translateY(-6px);
            animation: fadeSlideDown 0.6s ease 0.1s forwards;
        }

        .logo-dot {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: linear-gradient(135deg, var(--primary-dark), var(--primary));
            box-shadow: 0 4px 12px rgba(236, 51, 51, 0.35);
            flex-shrink: 0;
            position: relative;
            overflow: hidden;
        }

        .logo-dot::after {
            content: 'A';
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 16px;
            font-weight: 800;
            font-family: 'Sora', sans-serif;
            line-height: 32px;
            text-align: center;
        }

        .logo-text {
            font-size: 14px;
            font-weight: 700;
            color: var(--text);
            letter-spacing: -0.3px;
            display: none;
        }

        @media (min-width: 480px) {
            .logo-text { display: block; }
        }

        /* ============================================ */
        /* CENTER CONTENT                               */
        /* ============================================ */
        .center {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            max-width: 560px;
            width: 100%;
            gap: 0;
        }

        /* ============================================ */
        /* 404 NUMBER                                   */
        /* ============================================ */
        .error-number {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            line-height: 1;
            margin-bottom: -16px;
            z-index: 2;
            position: relative;
        }

        .digit {
            font-size: clamp(72px, 16vw, 130px);
            font-weight: 800;
            letter-spacing: -4px;
            color: transparent;
            -webkit-text-stroke: 2.5px var(--border);
            background: linear-gradient(180deg, rgba(228, 231, 240, 0.9) 0%, rgba(200, 207, 222, 0.5) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            opacity: 0;
            transform: translateY(20px);
            animation: fadeUp 0.7s ease 0.2s forwards;
            user-select: none;
        }

        .digit.mid {
            animation-delay: 0.3s;
            color: var(--primary);
            -webkit-text-stroke: 2.5px var(--primary);
            background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            text-shadow: 0 8px 32px rgba(236, 51, 51, 0.25);
        }

        /* ============================================ */
        /* IMAGEM BAD                                   */
        /* ============================================ */
        .bad-image-area {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 8px;
            opacity: 0;
            animation: imageReveal 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s forwards;
        }

        @keyframes imageReveal {
            from {
                opacity: 0;
                transform: translateY(30px) scale(0.85);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .bad-img {
            width: clamp(180px, 36vw, 280px);
            height: auto;
            display: block;
            position: relative;
            z-index: 2;
            user-select: none;
            -webkit-user-drag: none;
            filter: drop-shadow(0 24px 32px rgba(24, 30, 42, 0.14));
            cursor: pointer;
        }

        /* Ground shadow for depth */
        .bad-shadow {
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 70%;
            height: 22px;
            background: radial-gradient(ellipse at center, rgba(24, 30, 42, 0.18) 0%, transparent 75%);
            border-radius: 50%;
            z-index: 1;
        }

        /* ============================================ */
        /* TEXT BLOCK                                   */
        /* ============================================ */
        .text-block {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            margin-top: 20px;
            margin-bottom: 28px;
            opacity: 0;
            transform: translateY(12px);
            animation: fadeUp 0.6s ease 1s forwards;
        }

        .headline {
            font-size: clamp(20px, 4vw, 28px);
            font-weight: 700;
            color: var(--text);
            letter-spacing: -0.5px;
        }

        .subtext {
            font-size: clamp(13px, 2.5vw, 15px);
            color: var(--text-muted);
            font-weight: 400;
            max-width: 380px;
            line-height: 1.65;
        }

        /* ============================================ */
        /* BUTTON                                       */
        /* ============================================ */
        .btn-home {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: var(--primary);
            color: #fff;
            font-family: 'Sora', sans-serif;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 0.2px;
            padding: 12px 28px;
            border-radius: var(--radius-sm);
            text-decoration: none;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 4px 16px rgba(236, 51, 51, 0.28);
            position: relative;
            overflow: hidden;
            opacity: 0;
            transform: translateY(12px);
            animation: fadeUp 0.6s ease 1.15s forwards;
        }

        .btn-home::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, transparent 60%);
            opacity: 0;
            transition: opacity 0.25s ease;
        }

        .btn-home:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(236, 51, 51, 0.42);
            color: #fff;
        }

        .btn-home:hover::before {
            opacity: 1;
        }

        .btn-home:active {
            transform: translateY(0);
            box-shadow: 0 3px 10px rgba(236, 51, 51, 0.3);
        }

        .btn-icon {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
            transition: transform 0.25s ease;
        }

        .btn-home:hover .btn-icon {
            transform: scale(1.15);
        }

        /* ============================================ */
        /* ERROR LABEL                                  */
        /* ============================================ */
        .error-label {
            margin-top: 20px;
            font-size: 11px;
            color: var(--text-muted);
            letter-spacing: 0.3px;
            opacity: 0;
            animation: fadeUp 0.6s ease 1.3s forwards;
        }

        .error-label code {
            font-family: 'Courier New', monospace;
            font-size: 10px;
            background: var(--surface-3);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 2px 6px;
            color: var(--text-muted);
            letter-spacing: 0.5px;
        }

        /* ============================================ */
        /* KEYFRAMES                                    */
        /* ============================================ */
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeSlideDown {
            from { opacity: 0; transform: translateY(-6px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        @keyframes rippleAnim {
            to { transform: scale(1); opacity: 0; }
        }

        /* ============================================ */
        /* RESPONSIVE                                   */
        /* ============================================ */
        @media (max-width: 480px) {
            .wrapper {
                padding: 24px 16px;
                justify-content: center;
            }

            .logo-link {
                top: 16px;
                left: 16px;
            }

            .error-number {
                margin-bottom: -10px;
            }

            .digit {
                letter-spacing: -2px;
            }

            .bad-img {
                width: clamp(150px, 55vw, 220px);
            }

            .btn-home {
                padding: 11px 22px;
                font-size: 13px;
                width: 100%;
                max-width: 280px;
            }

            .text-block {
                margin-bottom: 22px;
            }
        }

        @media (max-width: 360px) {
            .headline {
                font-size: 18px;
            }
            .bad-img {
                width: 140px;
            }
            .btn-home {
                font-size: 12px;
                padding: 10px 18px;
            }
        }

        /* Landscape on small screens */
        @media (max-height: 600px) and (orientation: landscape) {
            body {
                overflow: auto;
            }
            .bad-img {
                width: 120px;
            }
            .digit {
                font-size: 60px;
            }
            .wrapper {
                padding: 70px 20px 32px;
                min-height: auto;
            }
        }
    </style>
</head>
<body>

    <!-- Background grid -->
    <div class="bg-grid"></div>
    <div class="bg-glow bg-glow-1"></div>
    <div class="bg-glow bg-glow-2"></div>

    <!-- Main wrapper -->
    <div class="wrapper">

        <!-- Logo top-left -->
        <a href="/" class="logo-link">
            <div class="logo-dot"></div>
            <span class="logo-text">AdminEscala</span>
        </a>

        <!-- Center content -->
        <main class="center">

            <!-- 404 number -->
            <div class="error-number" aria-hidden="true">
                <span class="digit">4</span>
                <span class="digit mid">0</span>
                <span class="digit">4</span>
            </div>

            <!-- Bad image area -->
            <div class="bad-image-area">
                <div class="bad-shadow"></div>
                <img
                    src="Bad.png"
                    alt="Bad"
                    class="bad-img"
                    draggable="false"
                />
            </div>

            <!-- Text content -->
            <div class="text-block">
                <h1 class="headline">Página não encontrada</h1>
                <p class="subtext">O endereço que você tentou acessar não existe ou foi movido.</p>
            </div>

            <!-- CTA Button -->
            <a href="/" class="btn-home">
                <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
                </svg>
                Voltar para o início
            </a>

            <!-- Error code small label -->
            <p class="error-label">Código de erro: <code>404_NOT_FOUND</code></p>

        </main>

    </div>

    <script>
        (function () {
            'use strict';

            /* ---------------------------------------------- */
            /* 1. Subtle parallax on background glows          */
            /* ---------------------------------------------- */
            const glow1 = document.querySelector('.bg-glow-1');
            const glow2 = document.querySelector('.bg-glow-2');

            let mouseX = 0, mouseY = 0;
            let raf;

            document.addEventListener('mousemove', (e) => {
                mouseX = e.clientX / window.innerWidth;
                mouseY = e.clientY / window.innerHeight;

                if (!raf) {
                    raf = requestAnimationFrame(updateGlows);
                }
            });

            function updateGlows() {
                raf = null;
                const dx = (mouseX - 0.5) * 40;
                const dy = (mouseY - 0.5) * 30;

                if (glow1) {
                    glow1.style.transform = `translate(${-dx}px, ${-dy}px)`;
                }
                if (glow2) {
                    glow2.style.transform = `translate(${dx}px, ${dy}px)`;
                }
            }

            /* ---------------------------------------------- */
            /* 2. Ripple effect on the home button             */
            /* ---------------------------------------------- */
            const btn = document.querySelector('.btn-home');

            if (btn) {
                btn.addEventListener('click', function (e) {
                    // Create ripple
                    const ripple = document.createElement('span');
                    const rect   = btn.getBoundingClientRect();
                    const size   = Math.max(rect.width, rect.height) * 2;
                    const x      = e.clientX - rect.left - size / 2;
                    const y      = e.clientY - rect.top  - size / 2;

                    Object.assign(ripple.style, {
                        position:     'absolute',
                        width:        size + 'px',
                        height:       size + 'px',
                        left:         x + 'px',
                        top:          y + 'px',
                        borderRadius: '50%',
                        background:   'rgba(255,255,255,0.25)',
                        transform:    'scale(0)',
                        animation:    'rippleAnim 0.55s ease-out forwards',
                        pointerEvents:'none',
                    });

                    btn.appendChild(ripple);
                    ripple.addEventListener('animationend', () => ripple.remove());
                });
            }

            /* ---------------------------------------------- */
            /* 3. Easter egg: click bad image 5× for a spin   */
            /* ---------------------------------------------- */
            const badImg = document.querySelector('.bad-img');
            let clickCount = 0;
            let clickTimer;

            if (badImg) {
                badImg.addEventListener('click', () => {
                    clickCount++;
                    clearTimeout(clickTimer);

                    if (clickCount >= 5) {
                        clickCount = 0;
                        badImg.style.transition = 'transform 0.8s cubic-bezier(0.34,1.56,0.64,1)';
                        badImg.style.transform  = 'rotate(360deg) scale(1.08)';
                        setTimeout(() => {
                            badImg.style.transform  = '';
                            badImg.style.transition = '';
                        }, 900);
                    } else {
                        clickTimer = setTimeout(() => { clickCount = 0; }, 800);
                    }
                });
            }

            /* ---------------------------------------------- */
            /* 4. Keyboard shortcut: Enter → go home           */
            /* ---------------------------------------------- */
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && document.activeElement.tagName !== 'A') {
                    window.location.href = '/';
                }
            });

        })();
    </script>
</body>
</html>
